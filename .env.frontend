# =============================================================================
# NuSaaS — Production self-hosted frontend environment
# =============================================================================
# Copy to web/.env.frontend. Docker injects these values into the pre-built
# frontend image when the container starts.

# API origin (no trailing /api — the application adds API paths itself)
VITE_API_URL=https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# Deployment and branding
VITE_DEPLOYMENT=self-hosted
VITE_APP_NAME="Your Business Name"
VITE_APP_DISPLAY_NAME="Your Business Name"
VITE_APP_TAGLINE="ERP & POS for East Africa"
VITE_APP_DESCRIPTION="Self-hosted ERP and POS platform."
VITE_APP_ENV=production
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WEBSITE=https://app.yourdomain.com
VITE_LEGAL_COMPANY_NAME="Your Business Name"
VITE_LEGAL_COPYRIGHT_NAME="Your Business Name"
VITE_PRIVACY_EMAIL=privacy@yourdomain.com
VITE_DOCS_URL=https://docs.yourdomain.com
VITE_BRANDFETCH_CLIENT_ID=

# Self-hosted feature flags
VITE_BILLING_ENABLED=false
VITE_DISABLE_RIGHT_CLICK=false
VITE_POS_OFFLINE_CACHE_HOURS=1

# Public Reverb endpoint — key must match backend REVERB_APP_KEY
VITE_REVERB_APP_KEY=CHANGE_ME_SAME_AS_BACKEND_REVERB_APP_KEY
VITE_REVERB_HOST=api.yourdomain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss

# Optional Google login
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# Optional Firebase browser push
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional error tracking
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=

# Maps — use a local tile endpoint for offline/LAN installs
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_MAX_ZOOM=19
VITE_MAP_EXTERNAL_LINKS=true
