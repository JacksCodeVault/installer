# Copy to .env.evolution; chmod 600. These are gateway-only settings.
AUTHENTICATION_API_KEY=REPLACE_WITH_RANDOM_GLOBAL_GATEWAY_SECRET
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
DATABASE_CONNECTION_CLIENT_NAME=nusaas-self-hosted
CACHE_REDIS_PREFIX_KEY=nusaas-self-hosted
CACHE_LOCAL_ENABLED=false
TELEMETRY_ENABLED=false
# A release can require separate licensing heartbeats despite this flag.
# Review licensing, release notes and outbound traffic before enabling it.
