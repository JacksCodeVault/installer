# =============================================================================
# NuSaaS — Self-Hosted Frontend Environment Template
# =============================================================================
# Copy this file to .env.local for local dev, or pass via Docker at runtime.
# For production self-hosted installs, install.sh generates web/.env.frontend
# automatically — you do not need to edit this file manually.
#
# All VITE_* variables are embedded at BUILD time by Vite.
# In the Docker image (ghostdev1/nusaas-web), values are injected at
# container startup via entrypoint.sh token substitution.
# =============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000

# ── Application Branding ──────────────────────────────────────────────────────
# Customise these to white-label for your organisation.
VITE_APP_NAME=NuSaaS
VITE_APP_DISPLAY_NAME="NuSaaS"
VITE_APP_TAGLINE="ERP & POS for East Africa"
VITE_APP_DESCRIPTION="Self-hosted ERP and POS platform."
VITE_APP_ENV=production
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_WEBSITE=http://localhost:5173
VITE_LEGAL_COMPANY_NAME="NuSaaS"
VITE_LEGAL_COPYRIGHT_NAME="NuSaaS"
VITE_PRIVACY_EMAIL=privacy@example.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Keep VITE_BILLING_ENABLED=false for all self-hosted deployments.
# Set to true only if you are running the cloud (SaaS) version.
VITE_BILLING_ENABLED=false

# ── WebSocket — Laravel Reverb ────────────────────────────────────────────────
# REVERB_APP_KEY must match the value in your backend .env.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8083
VITE_REVERB_SCHEME=ws

# ── Optional: Google OAuth ────────────────────────────────────────────────────
# Leave blank to disable the "Continue with Google" button on the login page.
# Requires GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET in the backend .env too.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Optional: Firebase Push Notifications ────────────────────────────────────
# Leave all blank to disable browser push notifications.
# Obtain values from Firebase Console → Project Settings → Web App → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ── eTIMS (Kenya Revenue Authority) ──────────────────────────────────────────
# Set to "production" when you go live with KRA eTIMS. Default: sandbox.
VITE_ETIMS_ENVIRONMENT=sandbox

# ── Onboarding Defaults ───────────────────────────────────────────────────────
# Pre-select values in the onboarding wizard before the backend config loads.
# These are overridden by whatever the user picks during setup.
VITE_ONBOARDING_DEFAULT_COUNTRY=KE
VITE_ONBOARDING_DEFAULT_CURRENCY=KES
VITE_ONBOARDING_DEFAULT_TIMEZONE=Africa/Nairobi
VITE_ONBOARDING_DEFAULT_LANGUAGE=en
VITE_ONBOARDING_DEFAULT_MODULES=pos,accounting,inventory,sales

# ── Sentry Error Tracking ─────────────────────────────────────────────────────
# Optional. Leave blank / false to disable error reporting.
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=
