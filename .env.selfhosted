# =============================================================================
# NuSaaS — Production self-hosted backend environment
# =============================================================================
# Copy to .env, replace every CHANGE_ME value, then create web/.env.frontend.
# This template matches the services in the public docker-compose.yml.

# Application
APP_DEPLOYMENT=self-hosted
APP_NAME="Your Business Name"
APP_DISPLAY_NAME="Your Business Name"
APP_TAGLINE="ERP & POS for East Africa"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_OPENSSL
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
PUBLIC_FRONTEND_URL="${FRONTEND_URL}"
WHATSAPP_CALLBACK_BASE_URL="${APP_URL}"
APP_TIMEZONE=Africa/Nairobi
APP_CURRENCY=KES
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Support and legal identity
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=
SUPPORT_WEBSITE="${FRONTEND_URL}"
SUPPORT_ADDRESS=
COMPANY_CITY=
COMPANY_COUNTRY=KE
PRIVACY_EMAIL=privacy@yourdomain.com

# Browser access and reverse proxy
# Keep the regex quoted: an unquoted leading # is parsed as a dotenv comment.
# Add multiple allowed origins as comma-separated quoted regex patterns.
CORS_ALLOWED_ORIGIN_PATTERNS='#^https://app\.yourdomain\.com$#'
TRUSTED_PROXIES=*
BCRYPT_ROUNDS=12

# MySQL container
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nusaas
DB_USERNAME=nusaas
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_PASSWORD
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Redis container
REDIS_CLIENT=predis
REDIS_HOST=cache
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# JWT authentication
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Meilisearch container
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://search:7700
MEILISEARCH_KEY=CHANGE_ME_STRONG_MEILISEARCH_KEY
SCOUT_QUEUE=true

# Laravel Reverb — internal Docker address used by the backend
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_REVERB_ID
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_HOST=ws
REVERB_PORT=8083
REVERB_SCHEME=http

# SMTP — use MAIL_SCHEME=smtps for implicit TLS providers, otherwise null.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="${SUPPORT_EMAIL}"
MAIL_BRAND_HOME_URL="${FRONTEND_URL}"
MAIL_BRAND_LOGO_URL="${APP_URL}/brand/nusaas-logo.png"

# Optional Google login — leave all blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Optional Firebase browser push — mount JSON at ./firebase/service-account.json
FIREBASE_CREDENTIALS_PATH=

# Optional error tracking
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Application backup settings (separate from the local shell backup helper)
BACKUP_FILENAME_PREFIX=nusaas-backup
BACKUP_FROM_NAME="${APP_NAME} Backups"
BACKUP_ADMIN_EMAIL="${SUPPORT_EMAIL}"
BACKUP_ARCHIVE_PASSWORD=

# Pinned application release and runtime limits
NUSAAS_VERSION=1.0.11
BILLING_ENABLED=false
SELF_HOSTED_BACKUP_MODE=local
REDIS_MAXMEMORY=512mb

# Customer-owned WhatsApp gateway (optional).
WHATSAPP_EVOLUTION_ENABLED=false
WHATSAPP_SELF_HOSTED_URL=
WHATSAPP_EVOLUTION_NATIVE_BUTTONS=false
WHATSAPP_EVOLUTION_NATIVE_LISTS=false

# Optional reviewed overlays; leave blank unless explicitly configured.
CLOUDFLARED_IMAGE=
EVOLUTION_IMAGE=
EVOLUTION_POSTGRES_IMAGE=
EVOLUTION_DB_PASSWORD=

# Optional customer-owned KRA OSCU integration. Configure sandbox in ERP Settings.
# Leave production off until the business has completed its KRA approval process.
ETIMS_PRODUCTION_ENABLED=false
ETIMS_APPROVED_PRODUCTION_TENANTS=

# M-Pesa credentials are saved in Settings → Payment Methods → M-Pesa, not here.
